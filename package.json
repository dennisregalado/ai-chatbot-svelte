{
	"name": "ai-chatbot-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "bun run build && wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types && mv worker-configuration.d.ts src/",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"auth:generate": "npx --yes @better-auth/cli@latest generate --config src/lib/auth.ts --output src/lib/server/db/auth.schema.ts -y",
		"db:generate": "drizzle-kit generate",
		"db:migrate:dev": "wrangler d1 migrations apply ai-sass --local",
		"db:migrate:prod": "wrangler d1 migrations apply ai-sass --remote",
		"db:studio:dev": "drizzle-kit studio",
		"db:studio:prod": "NODE_ENV=production drizzle-kit studio",
		"bun:update": "bun update --interactive --latest"
	},
	"devDependencies": {
		"@ai-sdk/svelte": "^3.0.107",
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.8.1",
		"@lucide/svelte": "^0.554.0",
		"@sejohnson/svelte-themes": "^0.0.6",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"ai": "^5.0.107",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.0",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"jsrepo": "^3.0.8",
		"mode-watcher": "^1.1.0",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "0.7.2",
		"svelte": "^5.45.5",
		"svelte-check": "^4.3.4",
		"svelte-sonner": "^1.0.7",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vaul-svelte": "0.3.2",
		"vite": "^7.2.6",
		"zod": "^4.1.12"
	},
	"packageManager": "bun@1.2.21",
	"dependencies": {
		"@better-auth-extended/onboarding": "^0.1.1",
		"@better-auth-extended/preferences": "^0.1.1",
		"@better-auth/passkey": "^1.4.5",
		"@cloudflare/puppeteer": "^1.0.4",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/state": "^6.5.2",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.38.8",
		"@libsql/client": "^0.15.15",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"agents": "^0.2.29",
		"better-auth": "^1.4.5",
		"better-auth-cloudflare": "^0.2.8",
		"codemirror": "^6.0.2",
		"partysocket": "^1.1.6",
		"resend": "^6.5.2",
		"runed": "^0.37.0",
		"stick-to-bottom-svelte": "^1.0.2",
		"svelte-highlight": "^7.9.0",
		"svelte-streamdown": "^3.0.0"
	}
}